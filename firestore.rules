rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Catch-All: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation functions
    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stock is number &&
             data.available is bool;
    }

    function isValidIngredient(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.unit is string && data.unit.size() <= 50 &&
             data.stock is number &&
             data.minStockAlert is number &&
             data.costPerUnit is number &&
             data.category is string && data.category.size() <= 100;
    }

    function isValidOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.orderNumber is string && data.orderNumber.size() <= 50 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200 &&
             data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 50 &&
             data.items is list && data.items.size() <= 100 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pendiente', 'en_preparacion', 'en_ruta', 'entregado', 'cancelado'] &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidBanner(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.subtitle is string && data.subtitle.size() <= 300 &&
             data.badge is string && data.badge.size() <= 50 &&
             data.imageUrl is string && data.imageUrl.size() <= 2000 &&
             data.active is bool;
    }

    function isValidBusinessProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.currentTheme is string && data.currentTheme.size() <= 50;
    }

    // Connection test document
    match /test/{testId} {
      allow get: if true;
    }

    // Products collection: Public catalog read, store write
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create, update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
    }

    // Ingredients collection: Central inventory stock
    match /ingredients/{ingredientId} {
      allow get: if isValidId(ingredientId);
      allow list: if true;
      allow create, update: if isValidId(ingredientId) && isValidIngredient(incoming());
      allow delete: if isValidId(ingredientId);
    }

    // Orders collection: Customers create orders, operations update
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId);
      allow delete: if isValidId(orderId);
    }

    // Banners collection: Storefront marketing
    match /banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create, update: if isValidId(bannerId) && isValidBanner(incoming());
      allow delete: if isValidId(bannerId);
    }

    // Business profiles: Store profile and settings
    match /business_profiles/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if true;
      allow create, update: if isValidId(profileId) && isValidBusinessProfile(incoming());
      allow delete: if isValidId(profileId);
    }
  }
}
